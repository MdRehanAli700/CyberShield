{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "VerifyPay: Start backend",
      "type": "process",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8001"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "verifyPay-backend",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "endsPattern": "Uvicorn running on"
        }
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
    },
    {
      "label": "VerifyPay: Start website",
      "type": "process",
      "command": "npm",
      "args": [
        "run",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "verifyPay-frontend",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "endsPattern": "Local:.*http://localhost:[0-9]+/"
        }
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
    },
    {
      "label": "VerifyPay: Start full app",
      "dependsOn": [
        "VerifyPay: Start backend",
        "VerifyPay: Start website"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
