DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/VerifyPay
# Local password reset email defaults to SMTP. The hosted Render demo uses Brevo's HTTPS API.
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Frontend origin used in reset links. Set this to the deployed HTTPS site when hosting.
FRONTEND_URL=http://localhost:5173
# Generate a private random value and keep it stable across API restarts. Required for provider sign-in.
OAUTH_SESSION_SECRET=
# Set a stable random value before enabling TOTP; if empty, OAUTH_SESSION_SECRET is used.
TOTP_ENCRYPTION_KEY=
# The public base URL of the API; used to construct provider callback addresses.
OAUTH_API_BASE_URL=http://localhost:5173
# Register these callback URLs in each provider's app registration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Microsoft tenant GUID or tenant domain (for example, contoso.onmicrosoft.com).
MICROSOFT_TENANT_ID=
# Enable for HTTPS deployments; leave false for local HTTP development.
OAUTH_COOKIE_SECURE=false
# Comma-separated browser origins allowed to call the API. Replace with your frontend origin when hosting.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Optional: set this if tesseract.exe is not on your Windows PATH.
# TESSERACT_CMD='C:\Program Files\Tesseract-OCR\tesseract.exe'
