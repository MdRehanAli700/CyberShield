DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/VerifyPay
# Password reset email: use your SMTP provider's host, port, username, password, and sender address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Frontend origin used in reset links. Set this to the deployed HTTPS site when hosting.
FRONTEND_URL=http://localhost:5173
# Comma-separated browser origins allowed to call the API. Replace with your frontend origin when hosting.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Optional: set this if tesseract.exe is not on your Windows PATH.
# TESSERACT_CMD='C:\Program Files\Tesseract-OCR\tesseract.exe'
